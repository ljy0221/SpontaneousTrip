<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ssafy.passproject.domain.auth.repository.RefreshRepository">

    <resultMap id="RefreshResultMap" type="com.ssafy.passproject.domain.auth.entity.Refresh">
        <id property="id" column="id"/>
        <result property="email" column="email"/>
        <result property="refreshToken" column="refresh_token"/>
        <result property="expiration" column="expiration"/>
    </resultMap>

    <!-- Refresh 토큰 존재 여부 확인 -->
    <select id="existsByRefresh" parameterType="string" resultType="boolean">
        SELECT COUNT(*) > 0
        FROM refresh
        WHERE refresh_token = #{refresh}
    </select>

    <!-- Refresh 토큰으로 조회 -->
    <select id="findByRefresh" parameterType="string" resultMap="RefreshResultMap">
        SELECT id, email, refresh_token, expiration
        FROM refresh
        WHERE refresh_token = #{refresh}
    </select>

    <!-- Refresh 토큰 저장 -->
    <insert id="insertRefresh" parameterType="com.ssafy.passproject.domain.auth.entity.Refresh" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO refresh (email, refresh_token, expiration)
        VALUES (#{email}, #{refreshToken}, #{expiration})
    </insert>

    <!-- Refresh 토큰 삭제 -->
    <delete id="deleteByRefresh" parameterType="string">
        DELETE FROM refresh
        WHERE refresh_token = #{refresh}
    </delete>

</mapper>
